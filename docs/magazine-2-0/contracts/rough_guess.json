{
  "corner_id": "rough_guess",
  "page_title": "어림짐작",
  "pages": {
    "min": 1,
    "max": 1
  },
  "publish_condition": "두 사람 성격 데이터 + 실측 항목(4~7) 1개 이상(사실상 그달 메시지 30건 이상) - 기획서 1절이 MASTER \"1·2·3·8만\" 폴백보다 앞선다",
  "skip_note": "성격 정보 없음: \"성격 정보가 아직 없어 싣지 않았습니다\"(DNA와 같은 문장) · 채팅 부족: \"이번 달 대화가 적어 싣지 않았습니다\"(메인 세션 제안 - PM 확인)",
  "llm_calls": 1,
  "fields": [
    {
      "path": "payload.disclaimer",
      "type": "string",
      "source": "고정 문구(MASTER 17-9 \"재미로만 봐주세요\")",
      "deterministic": true,
      "required": true,
      "tone": "합니다체"
    },
    {
      "path": "payload.items[]",
      "type": "array",
      "source": "src/engine/roughGuess.ts computeRoughGuess (1~6번 - 8번은 monthlyTopic.item · 7번은 busiestDay)",
      "deterministic": true,
      "required": true,
      "count": {
        "min": 3,
        "max": 6
      },
      "extra_rule": "채팅 30건 미만이면 1·2·3·8만(4개)"
    },
    {
      "path": "payload.items[].subject",
      "type": "string",
      "source": "DB profiles.display_name",
      "deterministic": true,
      "required": true,
      "extra_rule": "50% 미만이면 주체를 바꿔 표기 · 차이 10%p 미만이면 \"비슷합니다\"(기획서 2절 6.)"
    },
    {
      "path": "payload.items[].percent",
      "type": "number",
      "source": "TBD 엔진 (성격 벡터 기반 1·2·3 · 채팅 실측 4·5·6)",
      "deterministic": true,
      "required": true,
      "range": [
        50,
        100
      ],
      "decimals": 0
    },
    {
      "path": "payload.items[].source",
      "type": "'estimate'|'measured'",
      "source": "1~3 · 8 = estimate(성격만) · 4~6 = measured(src/engine/chatMetrics.ts)",
      "deterministic": true,
      "required": true,
      "extra_rule": "표기로 구분(기획서 2절 6.)"
    },
    {
      "path": "payload.busiestDay.date",
      "type": "string",
      "source": "src/engine/chatMetrics.ts busiestDay (KST 하루 메시지 수 최대 · 동점이면 이른 날)",
      "deterministic": true,
      "required": true
    },
    {
      "path": "payload.busiestDay.line",
      "type": "string",
      "source": "llm",
      "deterministic": false,
      "required": false,
      "max_chars": 20,
      "tone": "합니다체",
      "checks": [
        "말투(84-c)",
        "숫자·시각 대조(84-c)",
        "요일(84-c)",
        "금지어"
      ],
      "extra_rule": "\"그날은 OO 얘기가 오갔습니다\" · 추출 불가 시 null"
    },
    {
      "path": "payload.monthlyTopic.id",
      "type": "number",
      "source": "src/engine/roughGuess.ts selectMonthlyTopic = fnv1a32(couple_id + YYYY-MM) % 12 · 주제 풀 src/constants/roughGuessTopics.ts(v0 초안 - PM 승인)",
      "deterministic": true,
      "required": true,
      "range": [
        1,
        12
      ]
    }
  ],
  "sample": {
    "payload": {
      "disclaimer": "재미로만 봐주세요. 진짜로 재는 건 아닙니다.",
      "items": [
        {
          "key": "confess_first",
          "subject": "가람",
          "percent": 71,
          "measured": false
        },
        {
          "key": "talk_first",
          "subject": "나래",
          "percent": 55,
          "measured": true,
          "similar": true
        }
      ],
      "busiestDay": {
        "date": "2026-09-14",
        "line": "그날은 이사 얘기가 오갔습니다"
      },
      "monthlyTopic": {
        "id": 3
      }
    }
  },
  "open_questions": [
    "항목 1~3 · 8의 산출식(확률로 바꾸는 식)이 MASTER에 입력 변수만 있고 수식 없음 - v0 계수 결정 필요",
    "\"비슷해요\" 10%p 규칙을 게이지(5·6) · 좌우 비교(4)에도 거는지",
    "hashString 함수 · 주제 풀 12종 문장(출력 예)을 상수 파일로 확정할 PM 승인",
    "7번 LLM 입력(하루치 대화)을 원격 LLM에 보내는 범위 - 개인정보 처리방침과 대조"
  ],
  "common_rules": "contracts/README.md",
  "a1_implemented": {
    "by": "m20-a1 (2026-11-26)",
    "stored_schema": "src/types/corners/storedContent.ts RoughGuessPayloadSchema",
    "llm_module": "supabase/functions/_shared/corners/roughGuess.ts (LLM 1회 - busiestDay.line, 입력은 그날 메시지만 · 꼴/판정 낱말 검사)",
    "similar_rule": "확률 · 비율 항목 차이 10%p 미만 · 답장 속도(시간)는 상대 차이 10% 미만",
    "percent_formula_v0": "P(A) = clamp(50 + 50(s_A − s_B), 0, 100) · s = 입력 성향(0~1) 평균 - PM 승인 대상",
    "added_fields": [
      "payload.items[].kind",
      "payload.items[].line",
      "payload.items[].similar",
      "payload.items[].a/b(측정 항목)",
      "payload.busiestDay.count",
      "payload.footnote"
    ]
  }
}
