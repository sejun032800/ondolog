{
  "$name": "ONDOLOG App UI Tokens",
  "$version": "v3.5",
  "$source": "ONDOLOG_APP_UI_PLAN_v3.md",
  "$note": "앱 UI 전용. 발행물(PDF) 토큰은 ONDOLOG_CORNER_LAYOUT.md 참조.",

  "color": {
    "night":        { "value": "#14102E", "use": "기본 배경" },
    "nightDeep":    { "value": "#0C0920", "use": "그라디언트 끝" },
    "nightLift":    { "value": "#1F1A3D", "use": "카드 표면" },
    "nightLift2":   { "value": "#2A2350", "use": "눌림·선택 상태" },
    "text":         { "value": "#F3EFFA", "contrast": 16.2, "use": "본문·제목" },
    "textSub":      { "value": "#B9B2D8", "contrast": 9.1,  "use": "보조 설명" },
    "textMute":     { "value": "#8A83AE", "contrast": 5.2,  "use": "캡션·메타" },
    "textFaint":    { "value": "#5C5680", "contrast": 2.7,  "use": "선·비활성 전용. 텍스트 금지" },
    "coral":        { "value": "#FF8E7F", "contrast": 8.3,  "use": "온도·수치. 가장 중요한 액센트" },
    "pink":         { "value": "#F7A8C8", "contrast": 10.0, "use": "두 사람·관계" },
    "peri":         { "value": "#9AA2F7", "contrast": 7.8,  "use": "정보·링크" },
    "rule":         { "value": "#2C2650", "use": "구분선" },
    "lockBadgeText":{ "value": "#FFD6C8", "use": "구독 배지 글자" },
    "lockBadgeLine":{ "value": "rgba(255,142,127,0.55)", "use": "구독 배지 테두리" }
  },

  "gradient": {
    "sky":  { "angle": 180, "stops": ["#1B1440", "#14102E 46%", "#0C0920"], "use": "화면 배경" },
    "warm": { "angle": 135, "stops": ["#FF8E7F", "#F7A8C8"], "use": "온도 숫자·주요 버튼" },
    "dawn": { "angle": 135, "stops": ["#F7A8C8", "#9AA2F7"], "use": "두 사람 연결" },
    "veil": { "angle": 180, "stops": ["rgba(31,26,61,0)", "#1F1A3D"], "use": "사진 위 텍스트 바닥" }
  },

  "glow": {
    "soft": "0 0 32px rgba(255,142,127,0.18)",
    "card": "0 8px 32px rgba(8,5,20,0.45)",
    "$note": "그림자가 아니라 발광. 물체가 빛을 막는 게 아니라 스스로 빛난다."
  },

  "type": {
    "$family": { "sans": "Pretendard", "serif": "MaruBuri" },
    "hero":     { "family": "sans",  "weight": 900, "size": 72, "line": 76, "tracking": -0.045, "use": "온도 정수부" },
    "heroUnit": { "family": "sans",  "weight": 700, "size": 30, "line": 34, "tracking": -0.02,  "use": "소수·단위. 정수부의 42%" },
    "display":  { "family": "sans",  "weight": 700, "size": 28, "line": 38, "tracking": -0.02,  "use": "화면 제목" },
    "title":    { "family": "sans",  "weight": 700, "size": 19, "line": 28, "tracking": -0.02,  "use": "섹션·카드 제목" },
    "body":     { "family": "sans",  "weight": 400, "size": 16, "line": 26, "tracking": -0.01,  "use": "본문" },
    "sub":      { "family": "sans",  "weight": 400, "size": 14, "line": 22, "tracking": -0.01,  "use": "보조 설명" },
    "caption":  { "family": "sans",  "weight": 500, "size": 12, "line": 18, "tracking": 0,      "use": "메타·라벨" },
    "kicker":   { "family": "sans",  "weight": 700, "size": 11, "line": 14, "tracking": 0.18,   "use": "섹션 라벨" },
    "quote":    { "family": "serif", "weight": 400, "size": 17, "line": 30, "tracking": 0,      "use": "두 사람의 말 인용 전용" }
  },

  "ink": {
    "$note": "인쇄의 '먹 농도'를 화면의 '광도'로 번역한 것. 컴포넌트는 색을 고르지 않고 성격만 선언한다.",
    "metric":    { "color": "coral",   "glow": "soft", "use": "온도록이 계산한 값" },
    "narrative": { "color": "text",    "family": "sans", "use": "온도록이 쓴 문장" },
    "verbatim":  { "color": "textSub", "family": "serif", "use": "두 사람의 말 그대로" }
  },

  "radius": { "card": 20, "button": 16, "photo": 16, "chip": 999, "bubble": 20, "bubbleTail": 6, "input": 999 },
  "space":  { "screenX": 20, "cardPad": 20, "section": 32, "rowY": 15, "minTouch": 48 },

  "component": {
    "progressRule": { "height": 5, "radius": 999, "track": "rule", "fill": "gradient.warm", "animate": false },
    "barIndicator": { "width": 22, "activeWidth": 30, "height": 3, "gap": 5, "$note": "원형 금지" },
    "tabBar":       { "height": 84, "labelSize": 12, "labelWeight": 700, "$note": "아이콘 없이 텍스트만" },
    "lockBadge":    { "size": 11, "weight": 700, "padX": 9, "padY": 3, "radius": 999, "$note": "자물쇠 아이콘 금지" }
  },

  "sky": {
    "world":  { "asset": "sky_world.jpg", "widthPt": 390, "heightPt": 2000, "heightRatio": 2.37,
                "$note": "화면 높이 × 2.37. 전 화면이 같은 이미지를 다른 높이로 비춘다." },
    "viewOffsetPt": { "main": 1156, "pullStart": 1040, "pullRelease": 900, "sky": 620, "past": 60 },
    "veilOpacity":  { "main": 0.72, "pullStart": 0.50, "pullRelease": 0.20, "sky": 0.0 },
    "dateStar": {
      "corePt": [2.2, 4.2],
      "coreColor": "#FFFFFF",
      "haloDiameter": "core × 10",
      "haloGradient": "radial(photoColor AA 0%, photoColor 33 28%, transparent 70%)",
      "spikeWidth": "core × 8.4",
      "spikeAngles": [0, 90],
      "coreShadow": "0 0 3px 1px photoColor, 0 0 7px 2px photoColor99",
      "memoRing":   { "diameter": "core × 6.4", "color": "rgba(247,168,200,0.5)", "width": 0.7 },
      "annivRing":  { "diameter": "core × 10", "color": "rgba(255,214,168,0.45)", "style": "dashed" },
      "touchTarget": 44,
      "$note": "색은 그날 대표 사진 평균색을 명도 0.80 / 채도 ≥0.62로 올린 값"
    },
    "meteor": { "headPt": 4, "tailPt": 236, "thicknessPt": 1.4, "angleDeg": -31,
                "flightSec": 2.4, "intervalSec": [12, 25], "maxOnScreen": 1, "delayDays": 7 },
    "bgStar": { "sizePt": [1, 2], "interactive": false, "countPerWorld": 40000,
                "$note": "이미지에 구워져 있다. View로 그리지 않는다." }
  },

  "motion": {
    "screenEnter":  { "translateY": 12, "durationMs": 220 },
    "cardPress":    { "scale": 0.98, "durationMs": 120 },
    "sheet":        { "spring": { "damping": 0.8 } },
    "skyOpen":      { "durationMs": 480 },
    "starOpen":     { "durationMs": 360, "easing": "ease-out" },
    "bgStarTwinkle":{ "periodSec": [8, 12] },
    "forbidden":    ["온도 카운트업", "진행률 애니메이션", "스피너", "탭 전환 애니메이션", "배경·별 패럴랙스"]
  },

  "forbidden": {
    "icons":      "아이콘 라이브러리 미사용. 문자(→ ▲ ▼ ✕ ←)와 인라인 SVG만",
    "shadow":     "그림자 금지. 글로우로 대체",
    "errorColor": "에러색 금지. textMute + 텍스트 버튼",
    "blurLocked": "잠긴 테마 미리보기 흐리기 금지",
    "hardcoded":  "palette 밖 색 지정 금지"
  }
}
